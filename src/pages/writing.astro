---
import Base from '../layouts/Base.astro';
import { writing } from '../data/content';
---
<Base title="Writing — Lee White" description="Articles and posts by Lee White on accessibility, design systems, and web development.">
  <h1 class="page-title">Writing</h1>
  <ul>
    {writing.map((post) => (
      <li class="entry">
        <div class="entry__left">
          <p class="entry__pub">{post.publication}</p>
          <a href={post.url} class="entry__title" target="_blank" rel="noopener noreferrer">
            {post.title}
          </a>
        </div>
        <span class="entry__meta">{post.displayDate}</span>
      </li>
    ))}
  </ul>
</Base>
