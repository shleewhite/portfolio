---
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "UX engineer focused on design systems and accessibility." } = Astro.props;
const currentPath = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/og-preview.png" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="/og-preview.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;1,400&family=Unbounded:wght@700;800&display=swap" rel="stylesheet" />
    <ClientRouter />
  </head>
  <body>
    <div class="layout">
      <aside class="sidebar" aria-label="Site navigation">
        <span class="sidebar__name">Lee White</span>
        <nav>
          <ul class="sidebar__links">
            <li><a href="/" class="sidebar__link" aria-current={currentPath === '/' ? 'page' : undefined}>Home</a></li>
            <li><a href="/writing" class="sidebar__link" aria-current={currentPath === '/writing' ? 'page' : undefined}>Writing</a></li>
            <li><a href="/portfolio" class="sidebar__link" aria-current={currentPath === '/portfolio' ? 'page' : undefined}>Portfolio</a></li>
            <li><a href="/resume" class="sidebar__link" aria-current={currentPath === '/resume' ? 'page' : undefined}>Resume</a></li>
          </ul>
        </nav>
        <ul class="sidebar__footer-links">
          <li><a href="https://github.com/shleewhite" class="sidebar__footer-link" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span><span class="sr-only">(opens in new tab)</span></a></li>
          <li><a href="https://www.linkedin.com/in/lee-white-522ab1a1/" class="sidebar__footer-link" target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span><span class="sr-only">(opens in new tab)</span></a></li>
        </ul>
      </aside>

      <main transition:name="main-content" transition:animate="none">
        <div class="site-wrapper">
          <slot />
        </div>
      </main>
    </div>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
